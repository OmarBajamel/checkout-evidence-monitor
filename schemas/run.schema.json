{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Run",
  "$defs": {
    "RunStatus": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "CANCELLED",
        "FAILED"
      ]
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 40
        },
        "redirects": {
          "type": "integer",
          "default": 5,
          "minimum": 0,
          "maximum": 10
        },
        "step_seconds": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 60
        },
        "run_seconds": {
          "type": "integer",
          "default": 180,
          "minimum": 1,
          "maximum": 300
        },
        "events": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "maximum": 2000
        },
        "body_bytes": {
          "enum": [
            2097152
          ],
          "default": 2097152
        },
        "output_bytes": {
          "enum": [
            52428800
          ],
          "default": 52428800
        },
        "cdp_sessions": {
          "type": "integer",
          "default": 8,
          "minimum": 1,
          "maximum": 8
        }
      },
      "required": []
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "type": "string",
          "default": "synthetic-storefront",
          "pattern": "^[a-z0-9-]{1,64}$"
        },
        "fixture_version": {
          "type": "string",
          "default": "fixture-1"
        },
        "journey_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "browser_version": {
          "type": "string",
          "default": "153.0.8010.12"
        },
        "browser_revision": {
          "type": "string",
          "default": "1243"
        },
        "viewport": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "default": [
            1440,
            900
          ]
        },
        "locale": {
          "enum": [
            "en-US"
          ],
          "default": "en-US"
        },
        "consent": {
          "enum": [
            "DECLINED",
            "ACCEPTED",
            "UNSET"
          ],
          "default": "DECLINED"
        },
        "authentication": {
          "enum": [
            "SYNTHETIC_GUEST",
            "PUBLIC_GUEST"
          ],
          "default": "SYNTHETIC_GUEST"
        },
        "service_workers": {
          "enum": [
            "block",
            "allow"
          ],
          "default": "block"
        },
        "cache": {
          "enum": [
            "disabled-fresh"
          ],
          "default": "disabled-fresh"
        },
        "collector_version": {
          "type": "string",
          "default": "cem-cdp-1"
        },
        "rule_version": {
          "type": "string",
          "default": "obs-1"
        },
        "identity_key_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{16}$"
        },
        "mode": {
          "enum": [
            "HTTP",
            "PAGE",
            "JOURNEY"
          ],
          "default": "JOURNEY"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        }
      },
      "required": [
        "journey_hash",
        "identity_key_id"
      ]
    },
    "Grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "assessor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "profile": {
          "enum": [
            "LAB"
          ],
          "default": "LAB"
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^T(0[1-9]|1[0-9]|2[0-4])$"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 4
        },
        "actions": {
          "type": "array",
          "items": {
            "enum": [
              "goto",
              "click",
              "fill",
              "select",
              "wait",
              "assert",
              "stop"
            ]
          },
          "minItems": 1,
          "maxItems": 7
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "enum": [
            "SYNTHETIC_LOCAL_EVALUATION"
          ],
          "default": "SYNTHETIC_LOCAL_EVALUATION"
        }
      },
      "required": [
        "owner",
        "assessor",
        "fixture_id",
        "origins",
        "actions",
        "expires_at",
        "issued_at"
      ]
    },
    "Step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "action": {
          "enum": [
            "goto",
            "click",
            "fill",
            "select",
            "wait",
            "assert",
            "stop"
          ]
        },
        "selector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 160
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 160
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 100
        },
        "expected_state": {
          "anyOf": [
            {
              "enum": [
                "catalog",
                "cart",
                "checkout",
                "stopped"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "action"
      ]
    },
    "Job": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "1.0"
          ],
          "default": "1.0"
        },
        "profile": {
          "enum": [
            "LAB"
          ],
          "default": "LAB"
        },
        "grant": {
          "$ref": "#/$defs/Grant"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "maxItems": 40
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "consent": {
          "enum": [
            "DECLINED",
            "ACCEPTED",
            "UNSET"
          ],
          "default": "DECLINED"
        },
        "service_workers": {
          "enum": [
            "block",
            "allow"
          ],
          "default": "block"
        },
        "arm": {
          "enum": [
            "HTTP",
            "PAGE",
            "JOURNEY"
          ],
          "default": "JOURNEY"
        }
      },
      "required": [
        "grant",
        "steps"
      ]
    },
    "StepResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,40}$"
        },
        "state": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "enum": [
            "REACHED",
            "BLOCKED",
            "NOT_RUN"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 80
        },
        "started_at": {
          "type": "string",
          "description": "ISO 8601 timezone-aware timestamp; normalized to UTC by runtime validation."
        },
        "ended_at": {
          "type": "string",
          "description": "ISO 8601 timezone-aware timestamp; normalized to UTC by runtime validation."
        }
      },
      "required": [
        "id",
        "state",
        "status",
        "started_at",
        "ended_at"
      ]
    },
    "FrameRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80
        },
        "origin": {
          "type": "string",
          "maxLength": 250
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 80
        },
        "visibility": {
          "enum": [
            "METADATA",
            "NETWORK",
            "PARTIAL"
          ],
          "default": "METADATA"
        }
      },
      "required": [
        "id",
        "origin"
      ]
    },
    "CookieRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "domain": {
          "type": "string",
          "maxLength": 250
        },
        "path": {
          "type": "string",
          "maxLength": 250
        },
        "secure": {
          "type": "boolean"
        },
        "http_only": {
          "type": "boolean"
        },
        "same_site": {
          "type": "string",
          "maxLength": 20
        },
        "role": {
          "enum": [
            "CONFIGURED_SESSION",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        }
      },
      "required": [
        "name",
        "domain",
        "path",
        "secure",
        "http_only",
        "same_site"
      ]
    },
    "Evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "kind": {
          "enum": [
            "DOCUMENT",
            "SCRIPT",
            "REQUEST",
            "INLINE_METADATA",
            "LIMITATION"
          ]
        },
        "observed_at": {
          "type": "string",
          "description": "ISO 8601 timezone-aware timestamp; normalized to UTC by runtime validation."
        },
        "step_id": {
          "type": "string",
          "maxLength": 40
        },
        "state": {
          "type": "string",
          "maxLength": 40
        },
        "frame_id": {
          "type": "string",
          "default": "main",
          "maxLength": 80
        },
        "origin": {
          "type": "string",
          "default": "",
          "maxLength": 250
        },
        "url_display": {
          "type": "string",
          "default": "",
          "maxLength": 2048
        },
        "identity": {
          "type": "string",
          "default": "",
          "pattern": "^(?:[a-f0-9]{64})?$"
        },
        "reference_observed": {
          "type": "boolean",
          "default": false
        },
        "request_observed": {
          "type": "boolean",
          "default": false
        },
        "response_observed": {
          "type": "boolean",
          "default": false
        },
        "execution_evidence": {
          "enum": [
            "NOT_OBSERVED"
          ],
          "default": "NOT_OBSERVED"
        },
        "http_status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "minimum": 100,
          "maximum": 599
        },
        "method": {
          "type": "string",
          "default": "GET",
          "maxLength": 12
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20
        },
        "csp": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "maxItems": 20
        },
        "tls_validation": {
          "enum": [
            "VALIDATED",
            "FAILED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },
        "redirected_from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 2048
        },
        "from_cache": {
          "type": "boolean",
          "default": false
        },
        "from_service_worker": {
          "type": "boolean",
          "default": false
        },
        "body_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "pattern": "^[a-f0-9]{64}$"
        },
        "body_representation": {
          "anyOf": [
            {
              "enum": [
                "CDP_BASE64_DECODED",
                "CDP_TEXT_UTF8_REENCODED"
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "body_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "minimum": 0,
          "maximum": 2097152
        },
        "body_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "NOT_CAPTURED",
          "maxLength": 80
        },
        "content_type": {
          "type": "string",
          "default": "",
          "maxLength": 120
        },
        "content_encoding": {
          "type": "string",
          "default": "",
          "maxLength": 80
        },
        "integrity_metadata": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "maxLength": 512
        },
        "relation": {
          "enum": [
            "SAME_ORIGIN",
            "CROSS_ORIGIN",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },
        "delivery": {
          "enum": [
            "ATTEMPTED",
            "RESPONSE_OBSERVED",
            "FAILED",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },
        "limitation_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        }
      },
      "required": [
        "kind",
        "step_id",
        "state"
      ]
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "1.0"
          ],
          "default": "1.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "label": {
          "type": "string",
          "maxLength": 100
        },
        "fixture_id": {
          "type": "string",
          "pattern": "^(T(0[1-9]|1[0-9]|2[0-4])|PILOT)$"
        },
        "profile": {
          "$ref": "#/$defs/Profile"
        },
        "grant": {
          "anyOf": [
            {
              "$ref": "#/$defs/Grant"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "journey": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "maxItems": 40
        },
        "started_at": {
          "type": "string",
          "description": "ISO 8601 timezone-aware timestamp; normalized to UTC by runtime validation."
        },
        "ended_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 8601 timezone-aware timestamp; normalized to UTC by runtime validation."
        },
        "status": {
          "$ref": "#/$defs/RunStatus",
          "default": "PARTIAL"
        },
        "provenance": {
          "enum": [
            "COLLECTED_LAB",
            "COLLECTED_PILOT",
            "DECLARED_IMPORT",
            "SYNTHETIC_DEMO"
          ],
          "default": "DECLARED_IMPORT"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StepResult"
          },
          "maxItems": 40
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FrameRecord"
          },
          "maxItems": 100
        },
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CookieRecord"
          },
          "maxItems": 100
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 2000
        },
        "limitation_codes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 50
        },
        "complete_states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 40
        },
        "event_count": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "default": 0,
          "minimum": 0
        },
        "sanitized_artifact_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "label",
        "fixture_id",
        "profile"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_version": {
          "enum": [
            "obs-1"
          ],
          "default": "obs-1"
        },
        "id": {
          "type": "string"
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "condition": {
          "enum": [
            "MATCH",
            "NO_MATCH",
            "NOT_RUN",
            "INCONCLUSIVE"
          ]
        },
        "applicability": {
          "enum": [
            "APPLICABLE",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "evidence_sufficiency": {
          "enum": [
            "SUFFICIENT",
            "PARTIAL",
            "MISSING"
          ]
        },
        "confidence": {
          "enum": [
            "HIGH",
            "LIMITED",
            "UNKNOWN"
          ]
        },
        "severity": {
          "enum": [
            "INFO",
            "REVIEW_NEEDED",
            "ERROR"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interpretation": {
          "type": "string"
        },
        "suggested_owner": {
          "type": "string",
          "default": "Security reviewer"
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "rule_ids",
        "title",
        "condition",
        "applicability",
        "evidence_sufficiency",
        "confidence",
        "severity",
        "interpretation"
      ]
    },
    "Change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "SCRIPT",
            "HEADERS",
            "COOKIE"
          ],
          "default": "SCRIPT"
        },
        "kind": {
          "enum": [
            "ADDED",
            "CHANGED",
            "NOT_OBSERVED",
            "AMBIGUOUS",
            "UNOBSERVABLE"
          ]
        },
        "identity": {
          "type": "string"
        },
        "url_display": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "baseline_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "type": "string"
        },
        "new_origin": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "kind",
        "identity",
        "url_display",
        "state",
        "reason"
      ]
    },
    "Comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_id": {
          "type": "string"
        },
        "candidate_id": {
          "type": "string"
        },
        "eligibility": {
          "enum": [
            "COMPARABLE",
            "INCOMPATIBLE_PROFILE"
          ]
        },
        "mismatch_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "baseline_id",
        "candidate_id",
        "eligibility"
      ]
    }
  },
  "$comment": "AST-derived static contract. Runtime semantic validators also enforce timezone, body representation and scoped action invariants. No app imported to produce this file."
}
